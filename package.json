{
  "name": "koestudio",
  "private": true,
  "type": "module",
  "description": "KoeStudio drawing program (Python + pywebview, vanilla JS UI, no build step).",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\" && python -m unittest discover -s tests -p \"test_*.py\"",
    "test:js": "node --test \"tests/*.test.mjs\"",
    "test:py": "python -m unittest discover -s tests -p \"test_*.py\"",
    "check": "node tools/check_js.mjs"
  }
}
